<Window x:Class="InvoiceManager.AiInstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új AI-utasítás"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="AI-elemzés újrafuttatása"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#172B4D" />
            <TextBlock Text="Módosítsa az utasítást ehhez az újrapróbáláshoz. A beállításokban mentett utasítás nem változik."
                       Foreground="#6B778C"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="PDF képfelbontás (DPI)"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <ComboBox Width="120"
                          ItemsSource="{Binding ImageDpiOptions}"
                          SelectedItem="{Binding SelectedImageDpi, Mode=TwoWay}" />
            </StackPanel>
            <TextBlock Text="Alacsonyabb DPI esetén kisebb képek készülnek; a választás csak erre az újrapróbálásra érvényes."
                       Foreground="#6B778C"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <TextBox x:Name="InstructionTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 VerticalContentAlignment="Top"
                 Padding="10" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Mégse"
                    Background="#53657F"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click" />
            <Button Content="Újrafuttatás"
                    Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Window>
