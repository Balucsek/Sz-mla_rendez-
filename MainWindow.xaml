<Window x:Class="InvoiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Számlarendező"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Closing="MainWindow_Closing"
        Background="#F4F6F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172B4D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="—"
                            Width="48"
                            Padding="0"
                            Background="Transparent"
                            FontSize="20"
                            Click="MinimizeButton_Click" />
                    <Button Content="×"
                            Width="48"
                            Padding="0"
                            Background="Transparent"
                            FontSize="23"
                            Click="CloseButton_Click" />
                </StackPanel>
                <TextBlock Text="SZÁMLARENDEZŐ"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="22,0" />
            </DockPanel>
        </Border>

        <Grid x:Name="MenuPanel" Grid.Row="1" Visibility="Visible">
            <StackPanel Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Számlák kezelése"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#172B4D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="PDF számlák iktatása és keresése"
                           FontSize="18"
                           Foreground="#6B778C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32" />
                <Button x:Name="QuickScanButton"
                        Content="Gyors szkennelés"
                        Height="64"
                        FontSize="19"
                        Margin="0,0,0,16"
                        Click="QuickScanButton_Click" />
                <Button Content="Számlák iktatása"
                        Height="64"
                        FontSize="19"
                        Margin="0,0,0,16"
                        Click="StartRegistrationButton_Click" />
                <Button Content="Számlák keresése"
                        Height="64"
                        FontSize="19"
                        Background="#53657F"
                        Margin="0,0,0,16"
                        Click="OpenSearchButton_Click" />
                <Button Content="Beállítások"
                        Height="64"
                        FontSize="19"
                        Background="#53657F"
                        Margin="0,0,0,16"
                        Click="OpenSettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="IntakePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="26,12">
                <Button DockPanel.Dock="Right"
                        Content="Megszakítás"
                        Background="#53657F"
                        Click="CancelRegistrationButton_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Számlák iktatása"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#172B4D" />
                    <TextBlock x:Name="SourceFolderLabel"
                               FontSize="13"
                               Foreground="#6B778C"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="26,0,26,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#E0E5EC"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CurrentPdfLabel"
                                   Grid.Row="0"
                                   Text="Nincs megnyitott PDF"
                                   FontWeight="SemiBold"
                                   Foreground="#344563"
                                   VerticalAlignment="Center"
                                   Margin="16,0"
                                   TextTrimming="CharacterEllipsis" />
                        <wpf:WebView2 x:Name="PdfPreview" Grid.Row="1" />
                    </Grid>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#E0E5EC"
                            BorderThickness="1"
                            Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Iktatandó számlák"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#172B4D"
                                       Margin="2,2,2,10" />
                            <ListBox x:Name="PendingInvoicesList"
                                     ItemsSource="{Binding PendingInvoices}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,8" BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="#344563"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#E0E5EC"
                            BorderThickness="1"
                            Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Iktatott számlák"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#172B4D"
                                       Margin="2,2,2,10" />
                            <ListBox ItemsSource="{Binding RegisteredInvoices}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,8" BorderBrush="#EEF0F4" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding NewName}"
                                                           Foreground="#344563"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding OriginalName}"
                                                           Foreground="#929AA7"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusNote}"
                                                           Foreground="#53657F"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed" Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <Button DockPanel.Dock="Right"
                        Content="Vissza a menübe"
                        Background="#53657F"
                        Click="BackToMenuButton_Click" />
                <TextBlock Text="Számlák keresése"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#172B4D"
                           VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1"
                       Text="Az iktatási mappában a PDF-ek fájlneveiben keres."
                       Foreground="#6B778C"
                       Margin="0,0,0,10" />
            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchRootTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="Mappa kiválasztása" Click="ChooseSearchFolderButton_Click" />
                <TextBox x:Name="SearchQueryTextBox"
                         Grid.Column="4"
                         VerticalContentAlignment="Center"
                         ToolTip="Keresett szöveg a fájlnévben" />
                <Button x:Name="SearchButton" Grid.Column="6" Content="Keresés" Click="SearchButton_Click" />
            </Grid>
            <DockPanel Grid.Row="3">
                <TextBlock x:Name="SearchStatusLabel"
                           DockPanel.Dock="Top"
                           Foreground="#6B778C"
                           Margin="0,0,0,10" />
                <ListBox x:Name="SearchResultsList"
                         Background="White"
                         BorderBrush="#E0E5EC"
                         BorderThickness="1"
                         FontSize="15"
                         Padding="8" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
