<Window x:Class="InvoiceManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beállítások"
        Width="800"
        Height="820"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="SettingsWindow_Loaded"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Beállítások"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#172B4D"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="KeepOriginalFilesCheckBox"
                          Content="Eredeti fájl megőrzése"
                          FontSize="15"
                          Foreground="#344563"
                          Margin="0,0,0,18" />

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Cél mappa"
                               FontWeight="SemiBold"
                               Foreground="#344563"
                               Margin="0,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestinationFolderTextBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="📁"
                                Padding="7"
                                FontSize="17"
                                ToolTip="Célmappa kiválasztása"
                                Click="ChooseFolderButton_Click" />
                    </Grid>
                    <TextBlock Text="Az iktatott PDF-ek az év\hónap almappákba kerülnek."
                               Foreground="#6B778C"
                               FontSize="12"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Scan mappa"
                               FontWeight="SemiBold"
                               Foreground="#344563"
                               Margin="0,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScanFolderTextBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="📁"
                                Padding="7"
                                FontSize="17"
                                ToolTip="Scan mappa kiválasztása"
                                Click="ChooseScanFolderButton_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Szkenner"
                               FontWeight="SemiBold"
                               Foreground="#344563"
                               Margin="0,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ScannerComboBox"
                                  Grid.Column="0"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id" />
                        <Button Grid.Column="2"
                                Content="Frissítés"
                                Padding="12,8"
                                Background="#53657F"
                                Click="RefreshScannersButton_Click" />
                    </Grid>
                    <TextBlock x:Name="ScannerStatusTextBlock"
                               Foreground="#6B778C"
                               FontSize="12"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Border Background="White"
                        BorderBrush="#E0E5EC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="EnableAiAnalysisCheckBox"
                                  Content="AI elemzés (helyi Ollama)"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="#172B4D"
                                  Checked="EnableAiAnalysisCheckBox_Changed"
                                  Unchecked="EnableAiAnalysisCheckBox_Changed" />
                        <TextBlock Text="Az AI a PDF oldalait helyben, a kiválasztott vision modellel elemzi."
                                   Foreground="#6B778C"
                                   FontSize="12"
                                   Margin="0,5,0,12" />
                        <TextBlock Text="AI elemzési utasítás"
                                   FontWeight="SemiBold"
                                   Foreground="#344563"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="AiAnalysisInstructionTextBox"
                                 Height="160"
                                 MinLines="10"
                                 MaxLines="10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Padding="8"
                                 Margin="0,0,0,12" />
                        <TextBlock Text="A program a kért számlamezőket és a JSON kimenet formátumát rögzíti; itt az elemzés szempontjait módosíthatja."
                                   Foreground="#6B778C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,-7,0,12" />
                        <TextBlock Text="LLM modell"
                                   FontWeight="SemiBold"
                                   Foreground="#344563"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LlmModelComboBox"
                                      Grid.Column="0"
                                      SelectionChanged="LlmModelComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#344563" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                            <Setter Property="Foreground" Value="#929AA7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="ModelActionButton"
                                    Grid.Column="2"
                                    Content="Letöltés / indítás"
                                    Padding="12,8"
                                    Background="#53657F"
                                    Click="ModelActionButton_Click" />
                        </Grid>
                        <ProgressBar x:Name="AiModelProgressBar"
                                     Height="8"
                                     Margin="0,10,0,0"
                                     Visibility="Collapsed"
                                     IsIndeterminate="True" />
                        <TextBlock x:Name="AiModelStatusTextBlock"
                                   Foreground="#6B778C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="PDF képfelbontás (DPI)"
                                   FontWeight="SemiBold"
                                   Foreground="#344563"
                                   Margin="0,12,0,6" />
                        <ComboBox x:Name="AiImageDpiComboBox"
                                  Width="150"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="Alacsonyabb DPI kisebb képfájlokat eredményezhet, ami segíthet a nagy vagy többoldalas számlák feldolgozásánál."
                                   Foreground="#6B778C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <Button Content="Ollama telepítési instrukció"
                                HorizontalAlignment="Left"
                                Padding="12,7"
                                Margin="0,10,0,0"
                                Background="#53657F"
                                Click="OpenOllamaInstructionsButton_Click" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Számla elnevezés mintája"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#172B4D" />
                    <TextBlock Text="Húzza a mezőket a jobb oldali listába a kívánt sorrendben."
                               Foreground="#6B778C"
                               FontSize="12"
                               Margin="0,4,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Elérhető mezők"
                                       Foreground="#53657F"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <ListBox x:Name="AvailableNameFieldsList"
                                     Height="155"
                                     Background="White"
                                     PreviewMouseLeftButtonDown="AvailableNameFieldsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="AvailableNameFieldsList_PreviewMouseMove">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Padding="4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fájlnév sorrendje"
                                       Foreground="#53657F"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <ListBox x:Name="NamePatternList"
                                     Height="155"
                                     AllowDrop="True"
                                     Background="White"
                                     DragOver="NamePatternList_DragOver"
                                     Drop="NamePatternList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Padding="4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button Content="Eltávolítás"
                                Padding="12,7"
                                Background="#53657F"
                                Margin="0,0,8,0"
                                Click="RemovePatternFieldButton_Click" />
                        <Button Content="Alapértelmezés"
                                Padding="12,7"
                                Background="#53657F"
                                Click="ResetPatternButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PatternPreviewTextBlock"
                               Foreground="#53657F"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Mégse"
                    Background="#53657F"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click" />
            <Button Content="OK"
                    MinWidth="90"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
