<Window x:Class="InvoiceManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beállítások"
        Width="680"
        Height="560"
        MinWidth="580"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Beállítások"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#172B4D"
                   Margin="0,0,0,22" />

        <CheckBox x:Name="KeepOriginalFilesCheckBox"
                  Grid.Row="1"
                  Content="Eredeti fájl megőrzése"
                  FontSize="15"
                  Foreground="#344563"
                  Margin="0,0,0,24" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Cél mappa"
                       FontWeight="SemiBold"
                       Foreground="#344563"
                       Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationFolderTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="📁"
                        Padding="7"
                        FontSize="17"
                        ToolTip="Célmappa kiválasztása"
                        Click="ChooseFolderButton_Click" />
            </Grid>
            <TextBlock Text="Az iktatott PDF-ek az év\hónap almappákba kerülnek."
                       Foreground="#6B778C"
                       FontSize="12"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="Scan mappa"
                       FontWeight="SemiBold"
                       Foreground="#344563"
                       Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScanFolderTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="📁"
                        Padding="7"
                        FontSize="17"
                        ToolTip="Scan mappa kiválasztása"
                        Click="ChooseScanFolderButton_Click" />
            </Grid>
            <TextBlock Text="A gyors szkennelés ide menti átmenetileg a PDF-et az iktatás előtt."
                       Foreground="#6B778C"
                       FontSize="12"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,20,0,0">
            <TextBlock Text="Szkenner"
                       FontWeight="SemiBold"
                       Foreground="#344563"
                       Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ScannerComboBox"
                          Grid.Column="0"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id" />
                <Button Grid.Column="2"
                        Content="Frissítés"
                        Padding="12,8"
                        Background="#53657F"
                        Click="RefreshScannersButton_Click" />
            </Grid>
            <TextBlock x:Name="ScannerStatusTextBlock"
                       Foreground="#6B778C"
                       FontSize="12"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Mégse"
                    Background="#53657F"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click" />
            <Button Content="OK"
                    MinWidth="90"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
