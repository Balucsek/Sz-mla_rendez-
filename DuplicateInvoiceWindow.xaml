<Window x:Class="InvoiceManager.DuplicateInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Azonos nevű számla"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">
    <StackPanel Margin="24">
        <TextBlock Text="Figyelem: ilyen néven már van iktatott számla."
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#172B4D"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="DestinationLabel"
                   Margin="0,10,0,20"
                   Foreground="#53657F"
                   TextWrapping="Wrap" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Felülírás"
                    Margin="0,0,8,0"
                    Click="OverwriteButton_Click" />
            <Button Content="Hozzáfűzés"
                    Margin="0,0,8,0"
                    Click="AppendButton_Click" />
            <Button Content="Jelenlegi törlése"
                    Margin="0,0,8,0"
                    Click="DeleteCurrentButton_Click" />
            <Button Content="Mégse"
                    Background="#53657F"
                    Click="CancelButton_Click" />
        </WrapPanel>
    </StackPanel>
</Window>
