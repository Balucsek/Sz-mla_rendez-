<Window x:Class="InvoiceManager.InvoiceRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Számla iktatása"
        Width="800"
        Height="800"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Számla iktatása"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172B4D" />
            <TextBlock x:Name="SourceNameLabel"
                       Foreground="#6B778C"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Javasolt új fájlnév"
                               FontWeight="SemiBold"
                               Foreground="#344563"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="FileNameTextBox"
                             TextChanged="FileNameTextBox_TextChanged" />
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Év" FontWeight="SemiBold" Foreground="#344563" Margin="0,0,0,6" />
                        <ComboBox x:Name="YearComboBox"
                                  ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hónap" FontWeight="SemiBold" Foreground="#344563" Margin="0,0,0,6" />
                        <ComboBox x:Name="MonthComboBox"
                                  ItemsSource="{Binding Months}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Number"
                                  SelectedValue="{Binding SelectedMonth, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Border x:Name="AiAnalysisPanel"
                        Background="White"
                        BorderBrush="#E0E5EC"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="14"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel x:Name="AiProcessingPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <ProgressBar Width="120"
                                         Height="8"
                                         IsIndeterminate="True"
                                         Margin="0,0,12,0" />
                            <TextBlock Text="AI feldolgozás"
                                       Foreground="#3157A4"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="AiAnalysisErrorTextBlock"
                                   Foreground="#B54708"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="AiRetryActionsPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                            <Button ToolTip="A számla képének újragenerálása és az AI-elemzés újrapróbálása"
                                    Padding="4"
                                    Margin="0,0,6,0"
                                    Background="Transparent"
                                    Click="RetryAiAnalysisButton_Click">
                                <Grid Width="30" Height="30">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="23"
                                               Foreground="#2E9F57"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button ToolTip="Új utasítás megadása és az AI-elemzés újrafuttatása"
                                    Padding="4"
                                    Background="Transparent"
                                    Click="RetryAiAnalysisWithInstructionsButton_Click">
                                <Grid Width="30" Height="30">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="23"
                                               Foreground="#2E9F57"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="#3157A4"
                                               Background="#F4F6F8"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="InvoiceFieldsPanel"
                                    Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Számla dátuma" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="InvoiceDateStatusTextBlock" Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="InvoiceDateTextBox" Grid.Column="2" FontWeight="SemiBold" TextChanged="InvoiceFieldTextBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vevő" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="BuyerStatusTextBlock" Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="BuyerTextBox" Grid.Column="2" FontWeight="SemiBold" TextChanged="InvoiceFieldTextBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Eladó" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="SellerStatusTextBlock" Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="SellerTextBox" Grid.Column="2" FontWeight="SemiBold" TextChanged="InvoiceFieldTextBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Érték" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="TotalAmountStatusTextBlock" Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="TotalAmountTextBox" Grid.Column="2" FontWeight="SemiBold" TextChanged="InvoiceFieldTextBox_TextChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Számlaszám" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="InvoiceNumberStatusTextBlock" Grid.Column="1" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBox x:Name="InvoiceNumberTextBox" Grid.Column="2" FontWeight="SemiBold" TextChanged="InvoiceFieldTextBox_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#E0E5EC"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="14"
                        MinHeight="100">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="PDF szöveg-előnézet"
                                   FontWeight="SemiBold"
                                   Foreground="#344563"
                                   Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                            <TextBlock x:Name="ExtractedTextBlock"
                                       Foreground="#53657F"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Célmappa: kiválasztott mappa\év\hónap"
                       Foreground="#6B778C"
                       FontSize="12"
                       Margin="0,0,0,10" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Megszakítás"
                        Background="#53657F"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" />
                <Button x:Name="AppendButton"
                        Content="Előzőhöz fűzés"
                        Background="#53657F"
                        Margin="0,0,10,0"
                        Click="AppendButton_Click" />
                <Button Content="Iktatás"
                        Click="RegisterButton_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
